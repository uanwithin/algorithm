<mujoco model="lqr_cartpole">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4"/>
  <visual>
    <global offwidth="1200" offheight="800"/>
    <headlight ambient="0.6 0.6 0.6" diffuse="0.4 0.4 0.4" specular="0 0 0"/>
    <quality shadowsize="2048"/>
  </visual>
  <asset>
    <texture name="background" type="skybox" builtin="flat"
             rgb1="0.13 0.17 0.17" rgb2="0.13 0.17 0.17" width="32" height="32"/>
  </asset>
  <default>
    <!-- Ideal cart-pole: all geometry is visual, without contact or friction. -->
    <geom contype="0" conaffinity="0" density="0"/>
    <joint damping="0" frictionloss="0" armature="0" limited="false"/>
  </default>
  <worldbody>
    <camera name="side" pos="0 -3 0.43" xyaxes="1 0 0 0 0 1"
            projection="orthographic" fovy="1.5"/>
    <geom name="rail" type="box" pos="0 0 -0.01" size="1.0 0.035 0.008"
          rgba="0.55 0.6 0.56 1"/>
    <body name="cart" pos="0 0 0.075">
      <joint name="cart_x" type="slide" axis="1 0 0"/>
      <!-- Total cart mass includes the decorative wheels. -->
      <inertial pos="0 0 0" mass="1" diaginertia="0.01 0.01 0.01"/>
      <geom name="chassis" type="box" size="0.14 0.055 0.05" rgba="0.47 0.4 0.56 1"/>
      <geom type="cylinder" fromto="-0.09 -0.07 -0.037 -0.09 0.07 -0.037"
            size="0.03" rgba="0.1 0.12 0.12 1"/>
      <geom type="cylinder" fromto="0.09 -0.07 -0.037 0.09 0.07 -0.037"
            size="0.03" rgba="0.1 0.12 0.12 1"/>
      <geom type="cylinder" fromto="-0.09 -0.075 -0.037 -0.09 -0.071 -0.037"
            size="0.017" rgba="0.93 0.94 0.89 1"/>
      <geom type="cylinder" fromto="0.09 -0.075 -0.037 0.09 -0.071 -0.037"
            size="0.017" rgba="0.93 0.94 0.89 1"/>
      <body name="pole" pos="0 0 0.065">
        <!-- theta = 0 is upright; positive theta leans toward +X (screen right). -->
        <joint name="pole_angle" type="hinge" axis="0 1 0"/>
        <!-- Massless rigid rod + solid sphere: m=0.15, L=0.7, r=0.05. -->
        <inertial pos="0 0 0.7" mass="0.15" diaginertia="0.00015 0.00015 0.00015"/>
        <geom name="rod" type="capsule" fromto="0 0 0 0 0 0.7" size="0.004"
              rgba="0.75 0.79 0.74 1"/>
        <geom name="bob" type="sphere" pos="0 0 0.7" size="0.05"
              rgba="0.85 0.34 0.19 1"/>
        <geom name="pivot" type="sphere" pos="0 -0.02 0" size="0.013"
              rgba="0.8 0.55 0.2 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <!-- gear=1: ctrl is the horizontal force in N; the hinge is unactuated. -->
    <motor name="cart_force" joint="cart_x" gear="1" ctrllimited="true" ctrlrange="-10 10"/>
  </actuator>
  <keyframe>
    <key name="initial" qpos="0.2 -0.05" qvel="0 0"/>
  </keyframe>
</mujoco>
